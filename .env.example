# «Зууч» — орчны хувьсагчид (Railway/production)
# PORT — Railway өөрөө өгдөг; локалд 3300
PORT=3300
# PostgreSQL холболт (Ш1.2). Railway: ${{Postgres.DATABASE_URL}} reference
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Зураг/медиа хадгалах зам — Railway volume-д (/data/uploads)
ZUUCH_UPLOADS=./uploads
# Цуглуулагчийн хэшийн давс — заавал өөрчил
ZUUCH_SALT=солиорой-урт-random-мөр
# Платформын эзэн (super-admin) — зөвхөн env-ээс үүснэ
ZUUCH_OWNER_USER=owner
ZUUCH_OWNER_PASS=urt-nuuts-ug
ZUUCH_OWNER_RESET=0
# Ш3а Листингийн AI студи — Claude API түлхүүр (байхгүй бол загвар горим)
ANTHROPIC_API_KEY=
ZUUCH_AI_MODEL=claude-sonnet-5
