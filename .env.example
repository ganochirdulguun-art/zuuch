# «Зууч» — орчны хувьсагчид (Railway/production)
# PORT — Railway өөрөө өгдөг; локалд 3300
PORT=3300
# Өгөгдлийн сангийн зам — Railway persistent volume-д зааж өг (байнгын хадгалалт)
# Жишээ: /data/zuuch.db  (volume-ийг /data дээр mount хийсэн бол)
ZUUCH_DB=./zuuch.db
# Цуглуулагчийн хэшийн давс — заавал өөрчил (хувийн мэдээллийн хамгаалалт)
ZUUCH_SALT=солиорой-урт-random-мөр
